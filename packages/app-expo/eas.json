{
  "cli": {
    "version": ">= 18.11.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "autoIncrement": true,
      "developmentClient": true,
      "distribution": "internal",
      "node": "20.20.2",
      "pnpm": "9.15.0",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_NARRA_GATEWAY_AUTH_MODE": "installation",
        "EXPO_PUBLIC_NARRA_GATEWAY_URL": "https://api-test.narra.disrupt.builders",
        "EXPO_NO_METRO_WORKSPACE_ROOT": "1",
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "node": "20.20.2",
      "pnpm": "9.15.0",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_NARRA_GATEWAY_AUTH_MODE": "installation",
        "EXPO_PUBLIC_NARRA_GATEWAY_URL": "https://api-test.narra.disrupt.builders",
        "EXPO_NO_METRO_WORKSPACE_ROOT": "1",
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
      }
    },
    "preview": {
      "autoIncrement": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a"
      },
      "ios": {
        "simulator": false
      },
      "node": "20.20.2",
      "pnpm": "9.15.0",
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_NARRA_GATEWAY_AUTH_MODE": "installation",
        "EXPO_PUBLIC_NARRA_GATEWAY_URL": "https://api-test.narra.disrupt.builders",
        "EXPO_NO_METRO_WORKSPACE_ROOT": "1",
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "node": "20.20.2",
      "pnpm": "9.15.0",
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_NARRA_GATEWAY_AUTH_MODE": "installation",
        "EXPO_PUBLIC_NARRA_GATEWAY_URL": "https://api-test.narra.disrupt.builders",
        "EXPO_NO_METRO_WORKSPACE_ROOT": "1",
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
      }
    },
    "production-apk": {
      "autoIncrement": true,
      "distribution": "store",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a"
      },
      "node": "20.20.2",
      "pnpm": "9.15.0",
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_NARRA_GATEWAY_AUTH_MODE": "installation",
        "EXPO_PUBLIC_NARRA_GATEWAY_URL": "https://api-test.narra.disrupt.builders",
        "EXPO_NO_METRO_WORKSPACE_ROOT": "1",
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6801546949"
      }
    }
  }
}
